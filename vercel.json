{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": ["data/**/*.csv", "data/**/*.json"],
      "excludeFiles": [
        "tests/**",
        "reports/**",
        "work/**",
        "scripts/**",
        "public/**"
      ]
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
