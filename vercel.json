{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{data/**/*.csv,data/**/*.json}",
      "excludeFiles": "{tests/**,reports/**,work/**,scripts/**,.venv/**}"
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/index" },
    { "source": "/api/:path*", "destination": "/api/index" }
  ]
}
